rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validName(value) {
      return value is string
        && value.size() >= 1
        && value.size() <= 20
        && value.matches('.*\\S.*');
    }

    function roomPath(roomCode) {
      return /databases/$(database)/documents/gavindsChatRooms/$(roomCode);
    }

    function roomExists(roomCode) {
      return exists(roomPath(roomCode));
    }

    function roomData(roomCode) {
      return get(roomPath(roomCode)).data;
    }

    function activeMember(roomCode) {
      return signedIn()
        && roomExists(roomCode)
        && roomData(roomCode).status == 'open'
        && roomData(roomCode).expiresAt > request.time
        && request.auth.uid in roomData(roomCode).memberIds;
    }

    match /gavindsChatRooms/{roomCode} {
      // Direct room-code lookups are allowed, but rooms cannot be listed/browsed.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && roomCode.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly([
          'title', 'ownerUid', 'memberIds', 'memberNames',
          'status', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.keys().hasAll([
          'title', 'ownerUid', 'memberIds', 'memberNames',
          'status', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 32
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberNames is map
        && request.resource.data.memberNames.keys().hasOnly([request.auth.uid])
        && validName(request.resource.data.memberNames[request.auth.uid])
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h');

      // Clients may only join, leave, or rename themselves. They cannot change the
      // room title, owner, status, expiry, or another member's username.
      allow update: if signedIn()
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberIds', 'memberNames'])
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 0
        && request.resource.data.memberIds.size() <= 12
        && request.resource.data.memberNames is map
        && request.resource.data.memberNames.keys().hasAll(request.resource.data.memberIds)
        && (
          (
            request.auth.uid in request.resource.data.memberIds
            && !(request.auth.uid in resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.resource.data.memberNames.diff(resource.data.memberNames)
              .affectedKeys().hasOnly([request.auth.uid])
            && validName(request.resource.data.memberNames[request.auth.uid])
          )
          ||
          (
            request.auth.uid in resource.data.memberIds
            && !(request.auth.uid in request.resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
            && resource.data.memberIds.hasAll(request.resource.data.memberIds)
            && request.resource.data.memberNames.diff(resource.data.memberNames)
              .affectedKeys().hasOnly([request.auth.uid])
          )
          ||
          (
            request.auth.uid in resource.data.memberIds
            && request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.memberNames.diff(resource.data.memberNames)
              .affectedKeys().hasOnly([request.auth.uid])
            && validName(request.resource.data.memberNames[request.auth.uid])
          )
        );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /messages/{messageId} {
        allow get, list: if activeMember(roomCode);

        allow create: if activeMember(roomCode)
          && request.resource.data.keys().hasOnly([
            'userId', 'username', 'text', 'createdAt', 'expiresAt'
          ])
          && request.resource.data.keys().hasAll([
            'userId', 'username', 'text', 'createdAt', 'expiresAt'
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.username == roomData(roomCode).memberNames[request.auth.uid]
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 400
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(24, 'h');

        // Only a room host can manually remove an individual message.
        allow delete: if signedIn()
          && roomExists(roomCode)
          && roomData(roomCode).ownerUid == request.auth.uid;
        allow update: if false;
      }
    }
  }
}
